# задание 1

def binary_search(arr, key):
    low = 0
    high = len(arr) - 1
    while low <= high:
        mid = (low + high) // 2
        midVal = arr[mid]
        if midVal == key:
            return mid
        # Логика для убывающего массива
        if arr == sorted(arr)[::-1]:
            if midVal > key:
                low = mid + 1
            else:
                high = mid - 1
        # Логика для возрастающего массива
        else:
            if midVal > key:
                high = mid - 1
            else:
                low = mid + 1
    return low
print(binary_search([0, 1, 2, 3, 5, 6, 9], 8))  #Вывод: 6
print(binary_search([9, 8, 7, 5, 4, 2, 1], 6))  #Вывод: 3

# задание 2

def binary(arr):
    if len(arr) >= 3:
        low = 0
        high = len(arr) - 1
        while low < high:
            mid = (low + high) // 2
            if arr[mid] < arr[mid + 1]:
                low = mid + 1
            else:
                high = mid
        peak = low
        if peak == 0 or peak == len(arr) - 1:
            return "массив не горный"
        for i in range(peak):
            if arr[i] >= arr[i + 1]:
                return "массив не горный"
        for i in range(peak,len(arr)-1):
            if arr[i] <= arr[i + 1]:
                return "массив не горный"
        return peak
    else:
        return "массив не горный"
print(binary([1, 3, 5, 7, 6, 4, 2]))    # Вывод: 3
print(binary([1, 2, 3, 4, 5]))          # Вывод: массив не горный
print(binary([1,4]))                    # Вывод: массив не горный

