def solve(arr):
    if arr == sorted(arr):
        low = 0
        high = len(arr) - 1
        bor = len(arr)
        while low <= high:
            mid = (low+high) // 2
            if arr[mid] >= 0:
                bor = mid
                high = mid - 1
            else:
                low = mid + 1
        cntot = bor
        cntpo = 0
        for i in range(bor,len(arr)):
            if arr[i] > 0:
                cntpo += 1
        if cntpo > cntot:
            return cntpo
        else:
            return cntot
    return "массив не отсортирован по возрастанию"
print(solve([-3,-1,4,5,6,8,10]))  #Вывод: 5
print(solve([-10, -5, -2, 0, 0, 1, 3]))  #Вывод: 3

# задание 4

def solve(nums):
    counts = []
    for i in range(len(nums)):
        cnt = 0
        for j in range(i+1, len(nums)):
            if nums[i] > nums[j]:
                cnt += 1
        counts.append(cnt)
    return counts

print(solve([5, 2, 6, 1]))      # Вывод: [2, 1, 1, 0]
print(solve([5, 4, 3, 2, 1]))   # Вывод: [4, 3, 2, 1, 0]
